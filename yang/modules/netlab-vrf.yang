module netlab-vrf {
  yang-version 1.1;
  namespace "urn:exergy-connect:netlab:vrf";
  prefix vrf;

  import netlab-topology {
    prefix nt;
  }

  organization "Exergy Connect";
  description "VRF module augmentations.";

  revision 2026-07-16 {
    description "vrf-definition grouping for global/node VRF lists.";
  }

  grouping vrf-definition {
    description "Shared VRF object fields (global and per-node).";
    anydata bgp;
    leaf name {
      type string;
    }
    leaf rd {
      type string;
    }
    leaf-list import {
      type string;
    }
    leaf-list export {
      type string;
    }
  }

  augment "/nt:topology" {
    list vrfs {
      key "name";
      uses vrf-definition;
    }
  }

  augment "/nt:topology/nt:nodes" {
    anydata vrf {
      description "Node-level VRF module settings.";
    }
    list vrfs {
      key "name";
      uses vrf-definition;
    }
  }

  augment "/nt:topology/nt:groups" { anydata vrfs; }

  augment "/nt:topology/nt:links" {
    leaf vrf { type string; }
  }

  augment "/nt:topology/nt:nodes/nt:interfaces/nt:neighbors" { leaf vrf { type string; } }
}
