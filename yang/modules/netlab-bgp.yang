module netlab-bgp {
  yang-version 1.1;
  namespace "urn:exergy-connect:netlab:bgp";
  prefix bgp;

  import netlab-topology {
    prefix nt;
  }

  organization "Exergy Connect";
  description "BGP module augmentations.";

  revision 2026-07-16 {
    description "bgp-rr-attrs grouping for group/node BGP containers.";
  }

  grouping bgp-rr-attrs {
    description "BGP AS and route-reflector attributes shared by groups and nodes.";
    leaf as {
      type uint32;
    }
    leaf rr {
      type boolean;
    }
    leaf rr_cluster_id {
      type string;
    }
    leaf rr_mesh {
      type boolean;
    }
  }

  grouping bgp-common {
    anydata multihop;
    leaf advertise_loopback { type boolean; }
    leaf next_hop_self { type boolean; }
    leaf replace_global_as { type boolean; }
    container community {
      leaf-list ibgp { type string; }
      leaf-list ebgp { type string; }
      leaf-list localas_ibgp { type string; }
      leaf-list confed_ebgp { type string; }
    }
    container sessions {
      leaf-list ipv4 { type string; }
      leaf-list ipv6 { type string; }
    }
    container activate {
      leaf-list ipv4 { type string; }
      leaf-list ipv6 { type string; }
    }
  }

  grouping bgp-imports {
    list import {
      key "protocol";
      leaf protocol { type string; }
      leaf enabled { type boolean; }
      leaf auto { type boolean; }
      leaf policy { type string; }
    }
  }

  grouping bgp-interface-attrs {
    leaf allowas_in { type union { type boolean; type uint32; } }
    leaf local_as {
      type uint32;
    }
    leaf replace_global_as {
      type boolean;
    }
    leaf advertise {
      type boolean;
    }
    leaf default_originate {
      type boolean;
    }
  }

  augment "/nt:topology" {
    container bgp {
      uses bgp-common;
      leaf ebgp_role { type string; }
      leaf-list advertise_roles { type string; }
      leaf-list rr_list { type string; }
      list as_list {
        key "asn";
        leaf asn { type uint32; }
        leaf name { type string; }
        leaf-list members { type string; }
        leaf-list rr { type string; }
      }
      list confederation {
        key "asn";
        leaf asn { type uint32; }
        leaf-list members { type uint32; }
      }
      leaf as {
        type uint32;
      }
    }
  }

  // Groups inherit the node attribute namespace (attributes.yml node_group).
  augment "/nt:topology/nt:groups" {
    container bgp {
      uses bgp-rr-attrs;
      uses bgp-common;
    }
  }

  augment "/nt:topology/nt:nodes" {
    container bgp {
      uses bgp-rr-attrs;
      uses bgp-common;
      uses bgp-imports;
      leaf ipv4 { type boolean; }
      leaf ipv6 { type boolean; }
      anydata neighbors;
      list originate {
        leaf ipv4 { type string; }
        leaf ipv6 { type string; }
      }
      list advertise {
        leaf ipv4 { type string; }
        leaf ipv6 { type string; }
      }
      leaf local_as { type uint32; }
      leaf router_id {
        type string;
      }
      list neighbor {
        key "name";
        leaf name {
          type string;
        }
        leaf as {
          type uint32;
        }
        leaf type {
          type string;
        }
        leaf ipv4 {
          type string;
        }
        leaf ipv6 {
          type string;
        }
        leaf evpn {
          type string;
          description "EVPN address-family activation (e.g. ipv4).";
        }
      }
    }
  }

  augment "/nt:topology/nt:nodes/nt:interfaces" {
    container bgp {
      uses bgp-interface-attrs;
    }
  }

  augment "/nt:topology/nt:links/nt:interfaces" {
    container bgp {
      uses bgp-interface-attrs;
    }
  }

  augment "/nt:topology/nt:links" {
    container bgp {
      leaf advertise {
        type boolean;
      }
    }
  }
}
