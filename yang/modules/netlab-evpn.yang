module netlab-evpn {
  yang-version 1.1;
  namespace "urn:exergy-connect:netlab:evpn";
  prefix evpn;

  import netlab-vrf { prefix vrf; }

  import netlab-topology {
    prefix nt;
  }

  organization "Exergy Connect";
  description "EVPN module augmentations.";

  revision 2026-07-16 {
    description "evpn-common and evpn-rt-attrs groupings.";
  }

  grouping evpn-common {
    description "EVPN attributes shared by topology and node containers.";
    leaf as { type uint32; }
    leaf _junos_default_macvrf { type boolean; }
    anydata ethernet_segments;
    leaf-list session { type string; }
    leaf transport { type string; }
    leaf-list vlans { type string; }
    leaf-list vrfs { type string; }
  }

  grouping evpn-rt-attrs {
    description "EVPN route-target / EVI attributes on VLAN objects.";
    leaf evi { type uint32; }
    leaf rd { type vrf:route-distinguisher; }
    leaf-list import { type string; }
    leaf-list export { type string; }
  }

  augment "/nt:topology" {
    container evpn {
      uses evpn-common;
    }
  }

  grouping evpn-interface-attrs {
    leaf es { type string; }
    anydata _esi;
  }
  augment "/nt:topology/nt:links/nt:interfaces" { container evpn { uses evpn-interface-attrs; } }
  augment "/nt:topology/nt:nodes/nt:interfaces" { container evpn { uses evpn-interface-attrs; } }

  augment "/nt:topology/nt:groups" { container evpn { uses evpn-common; } }

  grouping evpn-vrf-attrs {
    uses evpn-rt-attrs;
    leaf bundle { type enumeration { enum vlan_aware; enum vlan; enum port; enum port_vlan; } }
    leaf transit_vni { type union { type uint32 { range "1..16777215"; } type string; type boolean; } }
  }

  augment "/nt:topology/vrf:vrfs" { container evpn { uses evpn-vrf-attrs; } }
  augment "/nt:topology/nt:nodes/vrf:vrfs" { container evpn { uses evpn-vrf-attrs; } }
  augment "/nt:topology/nt:groups/vrf:vrfs" { container evpn { uses evpn-vrf-attrs; } }

  augment "/nt:topology/nt:nodes" {
    container evpn {
      uses evpn-common;
      leaf domain { type string; }
    }
  }

  augment "/nt:topology/nt:vlans" {
    container evpn {
      uses evpn-rt-attrs;
    }
  }

  augment "/nt:topology/nt:nodes/nt:vlans" {
    container evpn {
      uses evpn-rt-attrs;
    }
  }
}
