{
  "name": "@exergy-connect/netlab",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p packages/core/tsconfig.json",
    "build:viewer": "vite build --config apps/lab-viewer/vite.config.ts",
    "build:all": "npm run build && npm run build:viewer",
    "build:pages": "node tools/sync-docs.mjs",
    "test": "tsx --test packages/core/tests/unit/**/*.test.ts",
    "test:compat": "tsx --test packages/core/tests/compatibility/**/*.test.ts",
    "viewer": "vite --config apps/lab-viewer/vite.config.ts",
    "gen:types": "node tools/gen-types.mjs",
    "embed:data": "node tools/embed-data.mjs",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "preview:viewer": "vite preview --config apps/lab-viewer/vite.config.ts",
    "build:action": "npm run build && node tools/bundle-action.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true
  },
  "version": "0.1.0",
  "description": "Netlab topology transformation core (YANG + xYang + JS transforms)",
  "license": "Apache-2.0",
  "main": "./packages/core/dist/index.js",
  "types": "./packages/core/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/core/dist/index.d.ts",
      "import": "./packages/core/dist/index.js",
      "default": "./packages/core/dist/index.js"
    },
    "./browser": {
      "types": "./packages/core/dist/browser.d.ts",
      "import": "./packages/core/dist/browser.js",
      "default": "./packages/core/dist/browser.js"
    }
  },
  "dependencies": {
    "@exergy-connect/xyang": "^1.0.5",
    "ipaddr.js": "^2.2.0",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
